APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-5.6-luna
OPENAI_REASONING_MODEL=gpt-5.6-terra
OPENAI_FINAL_MODEL=gpt-5.6-sol
OPENAI_TRANSCRIBE_MODEL=
OPENAI_EMBEDDING_MODEL=

YOUTUBE_API_KEY=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forex_video_intelligence
REDIS_URL=redis://localhost:6379

STORAGE_PROVIDER=local
STORAGE_PATH=./storage
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=

TRANSCRIPTION_PROVIDER=openai
AI_PROCESSING_MODE=standard
MOCK_AI_MODE=false

VIDEO_PROCESS_CONCURRENCY=2
AI_ANALYSIS_CONCURRENCY=5
FRAME_ANALYSIS_CONCURRENCY=3

FRAME_EVENT_BEFORE_SECONDS=15
FRAME_EVENT_AFTER_SECONDS=30
FRAME_INTERVAL_SECONDS=5
FRAME_OFFSETS_SECONDS=-15,-10,-5,0,5,10,20,30
MAX_FRAMES_PER_EVENT=8
MAX_CANDIDATE_EVENTS_PER_VIDEO=100

TRADING_EVENT_KEYWORDS=entry,entered,buy,sell,long,short,buying,selling,stop loss,sl,take profit,tp,target,exit,close,partial,breakeven,be,risk,rr,liquidity,sweep,breakout,retest,rejection,confirmation,setup,signal,trade,position,order

OPENAI_COST_TRACKING=true
LOG_LEVEL=info
