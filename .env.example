APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
MOCK_AI_MODE=true
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-5.6-luna
OPENAI_REASONING_MODEL=gpt-5.6-terra
OPENAI_FINAL_MODEL=gpt-5.6-sol
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
YOUTUBE_API_KEY=
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<database>?appName=<appName>
REDIS_URL=
STORAGE_PATH=./storage
AI_PROCESSING_MODE=standard
VIDEO_PROCESS_CONCURRENCY=2
AI_ANALYSIS_CONCURRENCY=5
FRAME_ANALYSIS_CONCURRENCY=3
FRAME_EVENT_BEFORE_SECONDS=15
FRAME_EVENT_AFTER_SECONDS=30
FRAME_INTERVAL_SECONDS=5
MAX_FRAMES_PER_EVENT=8
MAX_CANDIDATE_EVENTS_PER_VIDEO=100
OPENAI_COST_TRACKING=true
OPENAI_PRICING_JSON=
LOG_LEVEL=info
CLOUDINARY_URL=
