APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
MOCK_AI_MODE=false
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-3.8-flash
GEMINI_FINAL_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
YOUTUBE_API_KEY=
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<database>?appName=<appName>
REDIS_URL=redis://127.0.0.1:6379
CLOUDINARY_URL=
YTDLP_COOKIES_PATH=
STORAGE_PATH=./storage
DEFAULT_CHART_SYMBOL=FX:EURUSD
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
FFMPEG_PATH=
MAX_PLAYLIST_VIDEOS=500
AUDIO_CHUNK_SECONDS=600
MIN_HOLDOUT_TRADES=30
MIN_EXTRACTION_CONFIDENCE=0.8
AI_PROCESSING_MODE=standard
VIDEO_PROCESS_CONCURRENCY=2
AI_ANALYSIS_CONCURRENCY=5
FRAME_ANALYSIS_CONCURRENCY=3
FRAME_EVENT_BEFORE_SECONDS=15
FRAME_EVENT_AFTER_SECONDS=30
FRAME_INTERVAL_SECONDS=5
MAX_FRAMES_PER_EVENT=8
MAX_CANDIDATE_EVENTS_PER_VIDEO=100
GEMINI_COST_TRACKING=true
GEMINI_PRICING_JSON=
LOG_LEVEL=info

# --- Security (REQUIRED before exposing the app to the internet) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_URL=http://localhost:8000
ALLOW_OPEN_ACCESS=false
# --- Integrations ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BINANCE_BASE_URL=https://api.binance.com
DISPLAY_TZ=Asia/Kolkata
MAX_CHANNEL_VIDEOS=3000
INCLUDE_SHORTS=false
MAX_UPLOAD_MB=200
BACKTEST_PROCESSES=true
