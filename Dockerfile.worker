FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg python3 python3-pip ca-certificates && rm -rf /var/lib/apt/lists/* && pip3 install --break-system-packages --no-cache-dir yt-dlp
WORKDIR /app
COPY package*.json ./
COPY prisma ./prisma
COPY scripts ./scripts
RUN npm install
COPY . .
CMD ["npm","run","worker"]
